+      if (!fstat(fileno(fp), &st)) {
         ret         = calloc(1, sizeof(fb_file));
         ret->type   = FB_DIRECT;
         ret->size   = st.st_size;
diff --git a/src/tvheadend.h b/src/tvheadend.h
index 3ddf9e119..ac0980b9e 100644
--- a/src/tvheadend.h
+++ b/src/tvheadend.h
@@ -241,6 +241,7 @@ typedef struct th_pipe
 void doexit(int x);
 
 int tvh_open(const char *pathname, int flags, mode_t mode);
+int tvh_openat(int dirfd, const char *pathname, int flags, mode_t mode);
 
 int tvh_socket(int domain, int type, int protocol);
 
diff --git a/src/wrappers.c b/src/wrappers.c
index 1f93b22c5..c58461442 100644
--- a/src/wrappers.c
+++ b/src/wrappers.c
@@ -23,6 +23,24 @@ tvh_open(const char *pathname, int flags, mode_t mode)
   return fd;
 }
 
+int
+tvh_openat(int dirfd, const char *pathname, int flags, mode_t mode)
+{
+#ifdef O_CLOEXEC
+  /* Set close-on-exec atomically without two fcntl calls per child. */
+  return openat(dirfd, pathname, flags | O_CLOEXEC, mode);
+#else
+  int fd;
+
+  tvh_mutex_lock(&fork_lock);
+  fd = openat(dirfd, pathname, flags, mode);
+  if (fd != -1)
+    fcntl(fd, F_SETFD, fcntl(fd, F_GETFD) | FD_CLOEXEC);
+  tvh_mutex_unlock(&fork_lock);
+  return fd;
+#endif
+}
+
 int
 tvh_socket(int domain, int type, int protocol)
 {
diff --git a/support/startup-performance.md b/support/startup-performance.md
index 82c4394bf..4da483cc4 100644
--- a/support/startup-performance.md
+++ b/support/startup-performance.md
@@ -54,3 +54,33 @@ main or starting a server. It requires symbols, zlib and bundled defaults; it
 covers individual files, directory reads, recursion, gzip, symlinks, ignored
 hidden/backup files, missing paths and packaged fallback. All checks passed,
 including AddressSanitizer and UndefinedBehaviorSanitizer for set insertion.
+
+## Descriptor-relative file loading (2026-11-13 continuation)
+
+The published baseline `576105975` already reuses filebundle directories, but
+`fb_open2()` still concatenates and resolves the directory pathname for `fopen`
+and again for `stat` on every child. Direct files now use `tvh_openat()` on the
+existing directory descriptor, followed by `fdopen` and `fstat`. Close-on-exec is set atomically with `O_CLOEXEC` where available, with the
+fork-locked `fcntl` fallback retained on other platforms. Bundle lookup,
+compression, settings formats, and object creation remain unchanged.
+
+A disposable ext4 fixture with 58,865 synthetic mux directories, each containing
+one JSON config, produced identical complete serialized maps in all comparisons.
+Three consecutive loader calls per process, including allocation and decoding but
+excluding map destruction and fixture creation, gave these warm-cache medians:
+
+| Order | Baseline | Descriptor-relative |
+| --- | ---: | ---: |
+| Baseline first | 7.411 s | 6.614 s |
+| Candidate first | 7.447 s | 4.391 s |
+
+CPU medians were 7.410/6.610 s and 7.440/4.390 s (baseline/candidate).
+Candidate times varied substantially between processes, so these runs do not
+establish a stable percentage improvement. Resident memory after each final load
+was 47,040/46,848 KiB; serialization also contributes to the process high-water mark.
+
+These are isolated settings-loader measurements, not native startup or playback
+speedups. The previous real large fixture was unavailable. No new storage backend
+or startup cache is introduced. The expanded `test-settings-load.py` also checks
+long directory paths, dangling/directory symlinks, renamed open directories, and
+close-on-exec. It runs in the Flatpak SDK without libc debug types.
