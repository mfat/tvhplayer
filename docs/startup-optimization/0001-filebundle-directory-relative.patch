+longdir = LONGDIR
+assert load(longdir) == {'plain': {'value': 13}}
+# An open filebundle directory must remain usable if its pathname changes.
+directory = int(gdb.parse_and_eval('fb_opendir(%s)' % json.dumps(root + '/records')))
+assert directory
+os.rename(root + '/records', root + '/moved')
+file = int(gdb.parse_and_eval('fb_open2((fb_dir *)%d, "plain", 1, 0)' % directory))
+assert file
+assert int(gdb.parse_and_eval('fb_size((fb_file *)%d)' % file)) == len('{"value": 7}')
+# The descriptor must carry the same close-on-exec protection as tvh_fopen.
+fd = int(gdb.parse_and_eval('(int)fileno(((struct filebundle_file *)%d)->d.cur)' % file))
+assert int(gdb.parse_and_eval('(int)fcntl(%d, 1)' % fd)) & 1  # F_GETFD, FD_CLOEXEC
+gdb.execute('call fb_close((fb_file *)%d)' % file, to_string=True)
+assert not int(gdb.parse_and_eval('fb_open2((fb_dir *)%d, "absent", 1, 0)' % directory))
+gdb.execute('call fb_closedir((fb_dir *)%d)' % directory, to_string=True)
 # A missing local file/directory must still fall back to packaged defaults.
 assert load('profiles') == load('data/conf/profiles', bundled=True)
 assert load('profiles')
