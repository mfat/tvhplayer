diff --git a/support/sqlite-startup-import.py b/support/sqlite-startup-import.py
new file mode 100644
index 000000000..d661cc70e
--- /dev/null
+++ b/support/sqlite-startup-import.py
@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+"""Import a disposable configuration tree for the read-only startup experiment."""
+import json
+import os
+from pathlib import Path
+import sqlite3
+import sys
+import time
+
+
+def main():
+    if len(sys.argv) != 3:
+        raise SystemExit('usage: sqlite-startup-import.py FIXTURE DATABASE')
+    root = Path(sys.argv[1]).resolve()
+    target = Path(sys.argv[2]).absolute()
+    started = time.monotonic()
+    # Refuse replacement and protect credentials before writing the first byte.
+    descriptor = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    os.close(descriptor)
+    excluded = {target, Path(str(target) + '-journal'),
+                Path(str(target) + '-wal'), Path(str(target) + '-shm')}
+    counts = {'files': 0, 'directories': 0, 'payload_bytes': 0}
+    db = sqlite3.connect(target)
+    try:
+        db.executescript('''
+            CREATE TABLE nodes(path TEXT PRIMARY KEY, parent TEXT, name TEXT,
+                               kind INTEGER, ordinal INTEGER, data BLOB);
+            CREATE INDEX children ON nodes(parent, ordinal);
+        ''')
+
+        def visit(path, key, parent, name, ordinal):
+            if path.absolute() in excluded:
+                return
+            directory = path.is_dir() and not path.is_symlink()
+            data = None
+            if directory:
+                counts['directories'] += 1
+            else:
+                try:
+                    data = path.read_bytes()
+                except (OSError, ValueError):
+                    pass  # Preserve an unreadable/invalid file as a skipped row.
+                counts['files'] += 1
+                counts['payload_bytes'] += len(data) if data is not None else 0
+            db.execute('INSERT INTO nodes VALUES(?,?,?,?,?,?)',
+                       (key, parent, name, int(directory), ordinal, data))
+            if directory:
+                with os.scandir(path) as entries:
+                    for index, entry in enumerate(entries):
+                        child = entry.name if not key else key + '/' + entry.name
+                        visit(Path(entry.path), child, key, entry.name, index)
+
+        with db:
+            visit(root, '', None, '', 0)
+        assert db.execute('PRAGMA integrity_check').fetchone()[0] == 'ok'
+    finally:
+        db.close()
+    counts.update(database_bytes=target.stat().st_size,
+                  import_seconds=time.monotonic() - started,
+                  sqlite_version=sqlite3.sqlite_version)
+    print(json.dumps(counts))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/support/sqlite-startup-prototype.c b/support/sqlite-startup-prototype.c
new file mode 100644
index 000000000..38104b875
--- /dev/null
+++ b/support/sqlite-startup-prototype.c
@@ -0,0 +1,105 @@
+/* Isolated read-only startup snapshot experiment; never a production backend.
+ * Writers continue to use the disposable file tree. Rebuild this snapshot before
+ * every process. Missing entries retain ordinary packaged-default fallback. */
+#include <sqlite3.h>
+
+static sqlite3 *startup_db;
+
+static void
+sqlite_startup_check(int rc)
+{
+  if (rc != SQLITE_OK) {
+    fprintf(stderr, "SQLite startup experiment failed: %s\n",
+            startup_db ? sqlite3_errmsg(startup_db) : "open failed");
+    abort();
+  }
+}
+
+static htsmsg_t *
+sqlite_startup_decode(sqlite3_stmt *stmt, int column, const char *name)
+{
+  int size = sqlite3_column_bytes(stmt, column);
+  const void *blob = sqlite3_column_blob(stmt, column);
+  char *mem;
+  htsmsg_t *msg;
+  if (!blob) return NULL;
+  mem = malloc((size_t)size + 1);
+  if (!mem) abort();
+  memcpy(mem, blob, size);
+  mem[size] = 0;
+  msg = hts_settings_decode(name, mem, size);
+  free(mem);
+  return msg;
+}
+
+static htsmsg_t *
+sqlite_startup_load(const char *path, int depth)
+{
+  sqlite3_stmt *stmt = NULL;
+  htsmsg_t *result = NULL, *child;
+  char childpath[PATH_MAX];
+  const char *name;
+  int rc, directory = 0;
+
+  sqlite_startup_check(sqlite3_prepare_v2(startup_db,
+      "SELECT kind,data FROM nodes WHERE path=?", -1, &stmt, NULL));
+  sqlite_startup_check(sqlite3_bind_text(stmt, 1, path, -1, SQLITE_TRANSIENT));
+  rc = sqlite3_step(stmt);
+  if (rc == SQLITE_ROW) {
+    directory = sqlite3_column_int(stmt, 0);
+    if (!directory) result = sqlite_startup_decode(stmt, 1, path);
+  } else if (rc != SQLITE_DONE) {
+    sqlite_startup_check(rc);
+  }
+  sqlite_startup_check(sqlite3_finalize(stmt));
+  if (!directory) return result;
+
+  result = htsmsg_create_map();
+  sqlite_startup_check(sqlite3_prepare_v2(startup_db,
+      "SELECT name,kind,data FROM nodes WHERE parent=? ORDER BY ordinal",
+      -1, &stmt, NULL));
+  sqlite_startup_check(sqlite3_bind_text(stmt, 1, path, -1, SQLITE_TRANSIENT));
+  while ((rc = sqlite3_step(stmt)) == SQLITE_ROW) {
+    name = (const char *)sqlite3_column_text(stmt, 0);
+    if (!name || !*name || *name == '.' || name[strlen(name)-1] == '~')
+      continue;
+    if (sqlite3_column_int(stmt, 1)) {
+      if (depth <= 0) continue;
+      snprintf(childpath, sizeof(childpath), "%s%s%s", path, *path ? "/" : "", name);
+      child = sqlite_startup_load(childpath, depth - 1);
+    } else {
+      child = sqlite_startup_decode(stmt, 2, name);
+    }
+    if (child) htsmsg_add_msg(result, name, child);
+  }
+  if (rc != SQLITE_DONE) sqlite_startup_check(rc);
+  sqlite_startup_check(sqlite3_finalize(stmt));
+  return result;
+}
+
+static int
+sqlite_settings_load_path(const char *fullpath, int depth, htsmsg_t **result)
+{
+  const char *database = getenv("TVH_STARTUP_SQLITE");
+  size_t length;
+  if (!database || !*database || !settingspath) return 0;
+  length = strlen(settingspath);
+  if (strncmp(fullpath, settingspath, length) ||
+      (fullpath[length] && fullpath[length] != '/')) return 0;
+  if (!startup_db)
+    sqlite_startup_check(sqlite3_open_v2(database, &startup_db,
+                         SQLITE_OPEN_READONLY | SQLITE_OPEN_FULLMUTEX, NULL));
+  fullpath += length;
+  if (*fullpath == '/') fullpath++;
+  *result = sqlite_startup_load(fullpath, depth);
+  return 1;
+}
+
+static void
+sqlite_settings_done(void)
+{
+  if (startup_db) {
+    sqlite_startup_check(sqlite3_close(startup_db));
+    startup_db = NULL;
+  }
+}
