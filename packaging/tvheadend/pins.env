# The built-in server: the Tvheadend that the deb and rpm packages carry.
# io.github.mfat.tvhplayer.yml pins the same sources and options;
# tests/test_packaging_pins.py fails when the two disagree.

# The tvhplayer branch of TVHplayer's fork: an upstream commit plus fixes
# that are not upstream yet. docs/tvheadend-source.md says how to move it.
TVHEADEND_REPO=https://github.com/mfat/tvheadend
TVHEADEND_COMMIT=ca801fa96748b99ead0e7fc9bc132d0d89da676e
TVHEADEND_SHA256=bf7f0dd9b76fcc008fd9e541e29021b74a1c236353774ff42449c8971ee826f8
# What git describe prints for the commit. An archive has no .git to ask.
TVHEADEND_VERSION=4.3-2900~gca801fa96

DTV_SCAN_TABLES_COMMIT=31d6fb8f8b86e204518ada99bfb8cf6807c717e5
DTV_SCAN_TABLES_SHA256=279a04925ca4d944f6ae8b187bca01d15044789eea50239a56a53b2d81539ace

LIBDVBCSA_VERSION=1.1.0
LIBDVBCSA_SHA256=4db78af5cdb2641dfb1136fe3531960a477c9e3e3b6ba19a2754d046af3f456d

# HDHomeRun network tuners. build-libhdhomerun.sh links it into Tvheadend.
LIBHDHOMERUN_VERSION=20250815
LIBHDHOMERUN_SHA256=879b1bc476c9b93e77ee280a84fc1157e7cc47d43ed9c8398d88a8ac5f35c034

# No transcoding (VLC decodes), no Vue UI (needs npm; the classic UI is served at /),
# and nothing the build would download.
TVHEADEND_CONFIGURE_FLAGS="--disable-libav --disable-ffmpeg_static --disable-hdhomerun_static --enable-hdhomerun_client --disable-vue_build --disable-pcloud_cache --disable-avahi --disable-ccache"
