# libmpv for the Windows build: shinchiro's build, linked from https://mpv.io/installation/.
# The dev archive holds libmpv-2.dll with FFmpeg built in.
# mpv 0.42.0-38-gbcde6b93c / FFmpeg N-128766-gcd4e96eb3.
# Includes the NVDEC stale bitstream pointer fix (FFmpeg 03cd7851955c).
MPV_DEV_BUILD=20261111-git-bcde6b93cc
MPV_DEV_URL=https://github.com/shinchiro/mpv-winbuild-cmake/releases/download/20261111/mpv-dev-x86_64-20261111-git-bcde6b93cc.7z
MPV_DEV_SHA256=273c079b11ea5575822f972756f4c9a71149a5c10130353abeb8586738938452

# The Vulkan loader. libmpv-2.dll links vulkan-1.dll, which Windows does not
# ship (GPU drivers install it), so libmpv would not load in a VM or on a PC
# without one. Without a Vulkan driver the loader finds no device and mpv
# draws with OpenGL as always. From LunarG's Vulkan runtime components.
VULKAN_RT_VERSION=1.4.363.0
VULKAN_RT_URL=https://sdk.lunarg.com/sdk/download/1.4.363.0/windows/vulkan-runtime-components.zip
VULKAN_RT_SHA256=a25a927aa8b9f0371048f1861cf88ac3b9bc9b1fb332c42d897c8ab32695769a

# ffmpeg and ffprobe for recording to this computer and converting recordings:
# BtbN's static GPL build of FFmpeg 8.1, linked from ffmpeg.org.
FFMPEG_BUILD=autobuild-2026-11-15-12-40
FFMPEG_URL=https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-11-15-12-40/ffmpeg-n8.1.3-35-gf1acb0a266-win64-gpl-8.1.zip
FFMPEG_SHA256=ce121fcc8fe8097d6ab65c97ce34dc38b9e17006c31af26088ac6c91634dff28
