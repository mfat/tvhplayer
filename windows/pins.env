# libmpv for the Windows build: shinchiro's build, linked from https://mpv.io/installation/.
# The dev archive holds libmpv-2.dll with FFmpeg built in.
MPV_DEV_BUILD=20261021-git-e471496c56
MPV_DEV_URL=https://github.com/shinchiro/mpv-winbuild-cmake/releases/download/20261021/mpv-dev-x86_64-20261021-git-e471496c56.7z
MPV_DEV_SHA256=efc719eff3dc5954b4a5efc800632808bcec01cc9034940dd14e5eb7fe9ea633

# The Vulkan loader. libmpv-2.dll links vulkan-1.dll, which Windows does not
# ship (GPU drivers install it), so libmpv would not load in a VM or on a PC
# without one. Without a Vulkan driver the loader finds no device and mpv
# draws with OpenGL as always. From LunarG's Vulkan runtime components.
VULKAN_RT_VERSION=1.4.363.0
VULKAN_RT_URL=https://sdk.lunarg.com/sdk/download/1.4.363.0/windows/vulkan-runtime-components.zip
VULKAN_RT_SHA256=a25a927aa8b9f0371048f1861cf88ac3b9bc9b1fb332c42d897c8ab32695769a
