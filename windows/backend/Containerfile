# Build from the repository root; all TVHeadend sources/checksums come from pins.env.
ARG BASE_IMAGE=debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
FROM ${BASE_IMAGE} AS builder
COPY windows/backend/apt-snapshot.conf /etc/apt/apt.conf.d/80tvhplayer-snapshot
COPY windows/backend/debian.sources /etc/apt/sources.list.d/debian.sources
# snapshot.debian.org is flaky from CI; retry the whole install, not only single GETs.
RUN set -eu; n=0; \
    until apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
        build-essential pkg-config gettext bzip2 curl ca-certificates python3 \
        libssl-dev zlib1g-dev libpcre2-dev libdbus-1-dev libdvbcsa-dev \
        && rm -rf /var/lib/apt/lists/*; do \
      n=$((n + 1)); \
      if [ "$n" -ge 6 ]; then exit 1; fi; \
      echo "apt install failed (attempt $n); retrying in $((n * 30))s"; \
      sleep $((n * 30)); \
    done
COPY packaging/tvheadend /build/packaging
RUN sed -i 's/\r$//' /build/packaging/*.sh /build/packaging/pins.env \
    && sh /build/packaging/build-tvheadend.sh fetch /build/sources \
    && sh /build/packaging/build-tvheadend.sh build /build/sources /build/work --relocatable \
    && sh /build/packaging/build-tvheadend.sh install /build/work /out

FROM ${BASE_IMAGE} AS runtime
COPY windows/backend/apt-snapshot.conf /etc/apt/apt.conf.d/80tvhplayer-snapshot
COPY windows/backend/debian.sources /etc/apt/sources.list.d/debian.sources
RUN set -eu; n=0; \
    until apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
        ca-certificates ffmpeg libssl3 zlib1g libpcre2-8-0 libdbus-1-3 libdvbcsa1 \
        && rm -rf /var/lib/apt/lists/*; do \
      n=$((n + 1)); \
      if [ "$n" -ge 6 ]; then exit 1; fi; \
      echo "apt install failed (attempt $n); retrying in $((n * 30))s"; \
      sleep $((n * 30)); \
    done
COPY --from=builder /out/ /
COPY windows/backend/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod 755 /entrypoint.sh
EXPOSE 9981 9982
HEALTHCHECK --interval=10s --timeout=3s --start-period=60s --retries=3 CMD test -s /config/data/superuser && kill -0 1
ENTRYPOINT ["/entrypoint.sh"]

# The source artifact is built separately; users only load the runtime image.
FROM runtime AS sources
COPY windows/backend/base-sources.sources /etc/apt/sources.list.d/base-sources.sources
RUN mkdir -p /export /corresponding-source/debian \
    && dpkg-query -W -f='${Package}\t${Version}\t${source:Package}\t${source:Version}\t${Architecture}\n' > /export/packages.tsv \
    && tar -czf /export/licenses.tar.gz -C /usr/share doc \
    && ( set -eu; n=0; \
         until apt-get update && apt-get install -y --no-install-recommends dpkg-dev; do \
           n=$((n + 1)); \
           if [ "$n" -ge 6 ]; then exit 1; fi; \
           echo "apt source indexes failed (attempt $n); retrying in $((n * 30))s"; \
           sleep $((n * 30)); \
         done ) \
    && cut -f3,4 /export/packages.tsv | sort -u > /tmp/source-packages
# Fewer parallel fetches against snapshot.debian.org; retry each source package.
RUN --mount=type=cache,id=tvhplayer-debian-source-20261104,target=/source-cache \
    cd /source-cache \
    && xargs -r -P 2 -n 2 sh -c 'n=0; until apt-get source --download-only --only-source "$0=$1"; do n=$((n + 1)); if [ "$n" -ge 6 ]; then exit 1; fi; echo "source $0=$1 failed (attempt $n); retrying"; sleep $((n * 20)); done' < /tmp/source-packages \
    && cp -a /source-cache/. /corresponding-source/debian/
COPY --from=builder /build/sources /corresponding-source/tvheadend
COPY packaging/tvheadend /corresponding-source/build-instructions
COPY windows/backend/Containerfile windows/backend/apt-snapshot.conf windows/backend/debian.sources windows/backend/base-sources.sources windows/backend/entrypoint.sh /corresponding-source/backend/
RUN tar -czf /export/corresponding-source.tar.gz -C / corresponding-source

FROM scratch AS source-export
COPY --from=sources /export/ /

FROM runtime AS final
